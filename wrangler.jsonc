{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karsa-router",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "durable_objects": {
    "bindings": [
      {
        "name": "DB",
        "class_name": "DBServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DBServer"]
    }
  ]
}
